{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "value", "limits", "owner", "moves_by", "recheck_after_days", "public", "affects", "why", "if_raised"],
    "additionalProperties": false,
    "properties": {
      "key": {"type": "string"},
      "value": {},
      "limits": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {"min": {"type": "number"}, "max": {"type": "number"}, "allowed": {"type": "array"}}
      },
      "owner": {"enum": ["policy_owner", "steward", "project_owner"]},
      "moves_by": {"const": "person_only"},
      "recheck_after_days": {"type": "integer", "minimum": 1},
      "public": {"type": "boolean"},
      "as_of": {"type": "string"},
      "affects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "why": {"type": "string"},
      "if_raised": {"type": "string"}
    }
  }
}
